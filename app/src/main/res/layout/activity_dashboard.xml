<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#16B7CE"
    android:fillViewport="true"
    tools:context=".Dashboard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:background="#38AEEF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="DASHBOARD"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="LOG OUT"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- White dashboard section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/txtBudget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Budget: 1,800"
                android:textColor="#4B7FF2"
                android:textSize="25sp" />

            <!-- Weight, radial progress, height, and BMI -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="208dp"
                android:layout_marginTop="2dp">

                <!-- Left values -->
                <LinearLayout
                    android:layout_width="75dp"
                    android:layout_height="160dp"
                    android:layout_gravity="start|center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtWeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="● 55 kg"
                        android:textColor="#65D345"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtHeight"
                        android:layout_width="75dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="● 161 cm"
                        android:textColor="#D92F71"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtBMI"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="● 24.9"
                        android:textColor="#D9B52D"
                        android:textSize="16sp" />

                </LinearLayout>

                <!-- Radial progress bar -->
                <FrameLayout
                    android:layout_width="190dp"
                    android:layout_height="205dp"
                    android:layout_gravity="center">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/radialProgress"
                        android:layout_width="190dp"
                        android:layout_height="190dp"
                        android:layout_gravity="top|center_horizontal"
                        android:max="100"
                        android:progress="70"
                        app:indicatorColor="#4B7FF2"
                        app:indicatorInset="0dp"
                        app:indicatorSize="190dp"
                        app:indeterminate="false"
                        app:trackColor="#A686EA"
                        app:trackCornerRadius="0dp"
                        app:trackThickness="36dp" />

                    <View
                        android:layout_width="190dp"
                        android:layout_height="102dp"
                        android:layout_gravity="bottom"
                        android:background="#FFFFFF" />

                    <LinearLayout
                        android:layout_width="130dp"
                        android:layout_height="65dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="96dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtRemainingBudget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1000"
                            android:textColor="#4B7FF2"
                            android:textSize="25sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UNDER"
                            android:textColor="#4B7FF2"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </FrameLayout>

                <!-- Right labels -->
                <LinearLayout
                    android:layout_width="69dp"
                    android:layout_height="160dp"
                    android:layout_gravity="end|center_vertical"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:text="Weight ●"
                        android:textColor="#65D345"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="end"
                        android:text="Height ●"
                        android:textColor="#D92F71"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="end"
                        android:text="BMI ●"
                        android:textColor="#D9B52D"
                        android:textSize="14sp" />

                </LinearLayout>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date:"
                android:textColor="#10B4D0"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Date buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPreviousDate"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="60dp"
                    android:minHeight="60dp"
                    android:padding="0dp"
                    android:text="‹"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    app:backgroundTint="#38AEEF"
                    app:cornerRadius="30dp"
                    app:iconPadding="0dp" />

                <TextView
                    android:id="@+id/txtDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="11/16/2026"
                    android:textColor="#4B7FF2"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextDate"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="60dp"
                    android:minHeight="60dp"
                    android:padding="0dp"
                    android:text="›"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    app:backgroundTint="#38AEEF"
                    app:cornerRadius="30dp"
                    app:iconPadding="0dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Cyan button section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="370dp"
            android:background="#16B7CE"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="30dp"
            android:paddingEnd="12dp"
            android:paddingBottom="48dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetCalories"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="SET CALORIES"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                app:backgroundTint="#7699F3"
                app:cornerRadius="35dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetMeals"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="20dp"
                android:text="SET MEALS"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                app:backgroundTint="#7699F3"
                app:cornerRadius="35dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpdateProfile"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="20dp"
                android:text="UPDATE PROFILE / CALCULATE BMI"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#7699F3"
                app:cornerRadius="35dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>